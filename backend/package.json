{
  "name": "backend",
  "version": "1.0.0",
  "description": "BanhMi App Backend API",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:production": "NODE_ENV=production npm run build",
    "start": "node dist/index.js",
    "start:production": "NODE_ENV=production node dist/index.js",
    "start:staging": "NODE_ENV=staging node dist/index.js",
    "dev": "nodemon src/index.ts",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "test:unit": "jest --selectProjects unit",
    "test:integration": "jest --selectProjects integration --runInBand",
    "test:integration:watch": "jest --selectProjects integration --watch --runInBand",
    "test:all": "jest --runInBand",
    "test:models": "ts-node src/utils/testModels.ts",
    "test:auth": "ts-node src/utils/testAuth.ts",
    "test:auth-api": "ts-node src/utils/testAuthAPI.ts",
    "test:auth-complete": "ts-node src/utils/testAuthComplete.ts",
    "test:upload": "ts-node src/utils/testImageUpload.ts",
    "test:upload-complete": "ts-node src/utils/testImageUploadComplete.ts",
    "test:email": "ts-node src/utils/testEmailManagement.ts",
    "test:email-api": "ts-node src/utils/testEmailAPI.ts",
    "test:security": "ts-node src/utils/testSecurityImplementation.ts",
    "create:admin": "ts-node src/utils/createAdminUser.ts",
    "seed:email-templates": "ts-node src/scripts/seedDefaultEmailTemplates.ts",
    "test:automated-emails": "ts-node src/utils/testAutomatedEmails.ts",
    "test:email-templates": "ts-node src/utils/testAutomatedEmailTemplates.ts",
    "monitor:system": "bash ../scripts/system-monitor.sh",
    "backup:db": "bash ../scripts/backup-database.sh",
    "restore:db": "bash ../scripts/restore-database.sh",
    "setup:cron": "bash ../scripts/setup-cron-jobs.sh",
    "logs:rotate": "bash ../scripts/rotate-logs.sh"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "dependencies": {
    "bcryptjs": "^3.0.2",
    "cloudinary": "^2.7.0",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "express-rate-limit": "^8.1.0",
    "helmet": "^8.1.0",
    "isomorphic-dompurify": "^2.28.0",
    "joi": "^18.0.1",
    "jsonwebtoken": "^9.0.2",
    "mailtrap": "^4.2.0",
    "mongoose": "^8.18.1",
    "morgan": "^1.10.0",
    "multer": "^2.0.2",
    "nodemailer": "^7.0.6",
    "prom-client": "^15.1.0",
    "validator": "^13.15.15",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cookie-parser": "^1.4.9",
    "@types/cors": "^2.8.19",
    "@types/dompurify": "^3.0.5",
    "@types/express": "^5.0.3",
    "@types/jest": "^30.0.0",
    "@types/joi": "^17.2.2",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/mongoose": "^5.11.96",
    "@types/morgan": "^1.9.9",
    "@types/multer": "^2.0.0",
    "@types/node": "^24.3.1",
    "@types/nodemailer": "^7.0.1",
    "@types/supertest": "^6.0.3",
    "@types/validator": "^13.15.3",
    "axios": "^1.12.2",
    "jest": "^30.1.3",
    "mongodb-memory-server": "^10.2.1",
    "nodemon": "^3.1.10",
